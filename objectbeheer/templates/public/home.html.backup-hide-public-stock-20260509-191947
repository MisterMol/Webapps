{% extends "base/base.html" %}

{% block content %}
<section class="public-hero">
    <div class="public-hero-content">
        <p class="eyebrow">Restaurant De GraafMol</p>
        <h1>Robuuste gerechten, luxe snacks en cocktails met karakter.</h1>
        <p>
            Bekijk direct wat beschikbaar is. Geen gedoe, geen wachtrij in een app,
            gewoon zien waar je trek in krijgt.
        </p>

        <div class="hero-actions">
            <a class="button" href="{% url 'items:public_list' %}">Bekijk het menu</a>
            <a class="button secondary dark-secondary" href="{% url 'inventory:public_map' %}">Wat is beschikbaar?</a>
        </div>
    </div>

    <div class="public-hero-media">
        {% if branding and branding.default_item_image %}
            <img src="{{ branding.default_item_image.url }}" alt="Restaurant De GraafMol">
        {% elif branding and branding.logo %}
            <img src="{{ branding.logo.url }}" alt="Restaurant De GraafMol">
        {% else %}
            <div class="hero-placeholder">
                <span>GM</span>
                <small>Restaurant De GraafMol</small>
            </div>
        {% endif %}
    </div>
</section>

<section class="public-usps">
    <article>
        <span>01</span>
        <h2>Altijd actueel</h2>
        <p>Items zonder voorraad verdwijnen automatisch uit de klantweergave.</p>
    </article>

    <article>
        <span>02</span>
        <h2>Modern menu</h2>
        <p>Gerechten, snacks, burgers en dranken overzichtelijk op één plek.</p>
    </article>

    <article>
        <span>03</span>
        <h2>Robuuste stijl</h2>
        <p>Donker, strak en professioneel. Geen kinderfeestje, tenzij je bitterballen telt.</p>
    </article>
</section>

{% if featured_items %}
    <div class="section-title">
        <div>
            <h2>Uitgelicht</h2>
            <p>Populaire keuzes van dit moment.</p>
        </div>

        <a class="button secondary" href="{% url 'items:public_list' %}">Alles bekijken</a>
    </div>

    <div class="grid">
        {% for item in featured_items %}
            <a class="card interactive" href="{% url 'items:public_detail' item.slug %}">
                {% if item.should_show_image %}
                    <div class="card-image-wrap">
                        {% with media=item.primary_media %}
                            {% if media %}
                                {% if media.is_video %}
                                    <video class="card-image" muted playsinline>
                                        <source src="{{ media.image.url }}">
                                    </video>
                                {% else %}
                                    <img class="card-image" src="{{ media.image.url }}" alt="{{ media.alt_text|default:item.name }}">
                                {% endif %}
                            {% elif item.use_default_image_when_missing and branding and branding.default_item_image %}
                                <img class="card-image" src="{{ branding.default_item_image.url }}" alt="{{ item.name }}">
                            {% else %}
                                <div class="placeholder-image">{{ item.name }}</div>
                            {% endif %}
                        {% endwith %}
                    </div>
                {% endif %}

                <div class="card-body">
                    {% if item.category %}
                        <p class="meta">{{ item.category.name }}</p>
                    {% endif %}

                    <h2>{{ item.name }}</h2>

                    {% if item.short_description %}
                        <p>{{ item.short_description }}</p>
                    {% elif item.description %}
                        <p>{{ item.description|truncatewords:18 }}</p>
                    {% endif %}

                    {% if item.sale_price %}
                        <p class="price">€ {{ item.sale_price }}</p>
                    {% endif %}

                    {% if item.labels.all %}
                        <div class="badges">
                            {% for label in item.labels.all %}
                                <span class="badge">{{ label.name }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>
{% endif %}

<div class="section-title">
    <div>
        <h2>Menu ontdekken</h2>
        <p>Bekijk beschikbare gerechten, snacks, burgers, friet en dranken.</p>
    </div>
</div>

{% if public_items %}
    <div class="grid">
        {% for item in public_items %}
            <a class="card interactive" href="{% url 'items:public_detail' item.slug %}">
                {% if item.should_show_image %}
                    <div class="card-image-wrap">
                        {% with media=item.primary_media %}
                            {% if media %}
                                {% if media.is_video %}
                                    <video class="card-image" muted playsinline>
                                        <source src="{{ media.image.url }}">
                                    </video>
                                {% else %}
                                    <img class="card-image" src="{{ media.image.url }}" alt="{{ media.alt_text|default:item.name }}">
                                {% endif %}
                            {% elif item.use_default_image_when_missing and branding and branding.default_item_image %}
                                <img class="card-image" src="{{ branding.default_item_image.url }}" alt="{{ item.name }}">
                            {% else %}
                                <div class="placeholder-image">{{ item.name }}</div>
                            {% endif %}
                        {% endwith %}
                    </div>
                {% endif %}

                <div class="card-body">
                    {% if item.category %}
                        <p class="meta">{{ item.category.name }}</p>
                    {% endif %}

                    <h2>{{ item.name }}</h2>

                    {% if item.short_description %}
                        <p>{{ item.short_description }}</p>
                    {% elif item.description %}
                        <p>{{ item.description|truncatewords:18 }}</p>
                    {% endif %}

                    {% if item.sale_price %}
                        <p class="price">€ {{ item.sale_price }}</p>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>
{% else %}
    <div class="empty-state">
        Er zijn nog geen beschikbare items om te tonen.
    </div>
{% endif %}
{% endblock %}
