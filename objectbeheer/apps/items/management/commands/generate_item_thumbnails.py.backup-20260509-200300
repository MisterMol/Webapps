from pathlib import Path

from django.core.management.base import BaseCommand
from PIL import Image, ImageOps

from apps.items.models import ItemImage


MEDIA_ROOT = Path("media")
THUMB_DIR = MEDIA_ROOT / "items" / "thumbs"


class Command(BaseCommand):
    help = "Maakt snelle thumbnails voor itemmedia."

    def add_arguments(self, parser):
        parser.add_argument(
            "--force",
            action="store_true",
            help="Maak thumbnails opnieuw, ook als ze al bestaan.",
        )

    def handle(self, *args, **options):
        force = options["force"]
        THUMB_DIR.mkdir(parents=True, exist_ok=True)

        created = 0
        skipped = 0
        failed = 0

        media_files = ItemImage.objects.filter(
            is_public=True,
            media_kind__in=["image", "gif"],
        ).select_related("item")

        for media in media_files:
            source_path = Path(media.image.path)

            if not source_path.exists():
                self.stdout.write(self.style.WARNING(f"Bestand bestaat niet: {source_path}"))
                failed += 1
                continue

            thumb_name = f"{media.item.slug}-{media.id}.webp"
            thumb_path = THUMB_DIR / thumb_name

            if thumb_path.exists() and not force:
                skipped += 1
                continue

            try:
                with Image.open(source_path) as image:
                    image = ImageOps.exif_transpose(image)
                    image = image.convert("RGB")

                    image.thumbnail((700, 525), Image.Resampling.LANCZOS)

                    canvas = Image.new("RGB", (700, 525), (14, 13, 12))
                    x = (700 - image.width) // 2
                    y = (525 - image.height) // 2
                    canvas.paste(image, (x, y))

                    canvas.save(
                        thumb_path,
                        "WEBP",
                        quality=78,
                        method=6,
                    )

                created += 1
                self.stdout.write(self.style.SUCCESS(f"Thumbnail gemaakt: {thumb_path}"))

            except Exception as error:
                failed += 1
                self.stdout.write(self.style.ERROR(f"Mislukt voor {source_path}: {error}"))

        self.stdout.write("")
        self.stdout.write(self.style.SUCCESS(f"Klaar. Gemaakt: {created}. Overgeslagen: {skipped}. Mislukt: {failed}."))
